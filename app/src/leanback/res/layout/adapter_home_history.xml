<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_marginTop="-8dp"
    android:paddingTop="0dp"
    android:paddingBottom="8dp">

    <!-- Left vertical block -->
    <TextView
        android:id="@+id/left_bar"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_history_bar"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="10sp"
        android:lineSpacingMultiplier="0.9"
        android:text="@string/home_history_vertical"
        android:focusable="false"
        android:clickable="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- History HorizontalGridView -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintStart_toEndOf="@+id/left_bar"
        app:layout_constraintEnd_toStartOf="@+id/right_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right vertical block -->
    <TextView
        android:id="@+id/right_bar"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_history_bar"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:text="»"
        android:focusable="false"
        android:clickable="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
