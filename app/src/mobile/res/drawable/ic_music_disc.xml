<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <size android:width="280dp" android:height="280dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#2A2A2A" />
            <size android:width="260dp" android:height="260dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#0D0D0D" />
            <size android:width="240dp" android:height="240dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="ring"
            android:innerRadiusRatio="2.8"
            android:thicknessRatio="20"
            android:useLevel="false">
            <solid android:color="#1A1A1A" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#333333" />
            <size android:width="100dp" android:height="100dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#1A1A1A" />
            <size android:width="90dp" android:height="90dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF5722" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</layer-list>
