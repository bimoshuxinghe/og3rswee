<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <com.fongmi.android.tv.ui.custom.MusicDiscView
        android:id="@+id/musicDisc"
        android:layout_width="280dp"
        android:layout_height="336dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <com.fongmi.android.tv.ui.custom.LrcView
        android:id="@+id/musicLrcView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/musicDisc"
        android:layout_above="@id/musicControlBar"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/musicControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/musicSeekBar"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/musicPrev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/exo_icon_previous" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/musicPlay"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/exo_icon_play" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/musicNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/exo_icon_next" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <LinearLayout
        android:id="@+id/musicSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/musicCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            tools:text="00:00" />

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/musicProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#FF5722"
            android:thumbTint="#FF5722" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/musicTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            tools:text="00:00" />

    </LinearLayout>

</RelativeLayout>
