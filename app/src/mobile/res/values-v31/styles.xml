<resources>

    <!-- API 31+ 冷启动由系统绘制启动屏：透明图标 + 星落图主色背景，避免出现默认图标页 -->
    <style name="Theme.Splash" parent="Theme.Base">
        <item name="android:windowBackground">@drawable/splash_full</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

</resources>
